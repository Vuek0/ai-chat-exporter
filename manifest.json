{
  "manifest_version": 3,
  "name": "AI Chat Exporter",
  "version": "1.1.0",
  "description": "Экспорт полной истории чата из ChatGPT, Claude, Gemini и Google AI Mode в JSON или Markdown.",
  "permissions": ["activeTab", "scripting", "downloads", "clipboardWrite", "storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Экспортировать чат",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.google.com/search*"
      ],
      "js": [
        "src/common.js",
        "src/format.js",
        "src/extractors/chatgpt.js",
        "src/extractors/claude.js",
        "src/extractors/gemini.js",
        "src/extractors/google-ai.js",
        "src/content.js",
        "src/ui.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
