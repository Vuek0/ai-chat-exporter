{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.5.0",
  "author": "Vuek0",
  "homepage_url": "https://github.com/Vuek0/ai-chat-exporter",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["activeTab", "scripting", "downloads", "clipboardWrite", "storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.google.com/search*"
      ],
      "js": [
        "src/common.js",
        "src/format.js",
        "src/extractors/chatgpt.js",
        "src/extractors/claude.js",
        "src/extractors/gemini.js",
        "src/extractors/google-ai.js",
        "src/content.js",
        "src/zip.js",
        "src/bulk.js",
        "src/ui.js",
        "src/transfer.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
